# ══════════════════════════════════════════════════════
# HIBI MATCHA — Google Workspace MCP Server
# ══════════════════════════════════════════════════════
# เลือกใช้วิธีใดวิธีหนึ่ง:
#   วิธีที่ 1 = Service Account  ← แนะนำสำหรับ Remote/Cloud
#   วิธีที่ 2 = OAuth2           ← สำหรับ Local/Personal Account

# ──────────────────────────────────────────────────────
# วิธีที่ 1: SERVICE ACCOUNT (Remote-friendly ✅)
# ──────────────────────────────────────────────────────
# Path ไปยังไฟล์ service-account-key.json ที่ดาวน์โหลด
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./mcp-google/service-account-key.json

# หรือใส่ JSON ตรงๆ เป็น single line (สำหรับ CI/CD)
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"..."}

# ──────────────────────────────────────────────────────
# วิธีที่ 2: OAUTH2 + REFRESH TOKEN (Local เท่านั้น)
# ──────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=http://localhost:3001/oauth2callback
# GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxx
