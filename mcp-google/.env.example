# Google OAuth2 Credentials
# สร้างได้ที่ https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth2callback

# Google Refresh Token (ได้จากการ run: npm run dev -- --auth)
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Hibi Matcha Google Drive Root Folder ID (สร้างครั้งแรกแล้วเก็บไว้)
HIBI_DRIVE_ROOT_FOLDER_ID=
